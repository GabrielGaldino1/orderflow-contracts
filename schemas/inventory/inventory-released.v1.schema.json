{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderflow.dev/schemas/inventory/inventory-released.v1.schema.json",
  "title": "InventoryReleased.v1",
  "allOf": [
    { "$ref": "../common/event-envelope.v1.schema.json" },
    {
      "properties": {
        "eventType": { "const": "InventoryReleased" },
        "eventVersion": { "const": 1 },
        "producer": { "const": "inventory-worker" },
        "payload": { "$ref": "#/$defs/payload" }
      }
    }
  ],
  "$defs": {
    "releasedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productId", "quantity"],
      "properties": {
        "productId": { "type": "string", "format": "uuid" },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reservationId", "orderId", "releasedAt", "releasedItems"],
      "properties": {
        "reservationId": { "type": "string", "format": "uuid" },
        "orderId": { "type": "string", "format": "uuid" },
        "releasedAt": { "type": "string", "format": "date-time" },
        "releasedItems": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/releasedItem" }
        }
      }
    }
  }
}
