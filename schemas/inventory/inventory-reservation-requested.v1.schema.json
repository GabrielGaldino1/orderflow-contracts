{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderflow.dev/schemas/inventory/inventory-reservation-requested.v1.schema.json",
  "title": "InventoryReservationRequested.v1",
  "allOf": [
    { "$ref": "../common/event-envelope.v1.schema.json" },
    {
      "properties": {
        "eventType": { "const": "InventoryReservationRequested" },
        "eventVersion": { "const": 1 },
        "producer": { "const": "order-service" },
        "payload": { "$ref": "#/$defs/payload" }
      }
    }
  ],
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productId", "quantity"],
      "properties": {
        "productId": { "type": "string", "format": "uuid" },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderId", "items"],
      "properties": {
        "orderId": { "type": "string", "format": "uuid" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/item" }
        }
      }
    }
  }
}
