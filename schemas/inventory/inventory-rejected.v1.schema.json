{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderflow.dev/schemas/inventory/inventory-rejected.v1.schema.json",
  "title": "InventoryRejected.v1",
  "allOf": [
    { "$ref": "../common/event-envelope.v1.schema.json" },
    {
      "properties": {
        "eventType": { "const": "InventoryRejected" },
        "eventVersion": { "const": 1 },
        "producer": { "const": "inventory-worker" },
        "payload": { "$ref": "#/$defs/payload" }
      }
    }
  ],
  "$defs": {
    "rejectedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productId", "requestedQuantity"],
      "properties": {
        "productId": { "type": "string", "format": "uuid" },
        "requestedQuantity": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderId", "reasonCode", "rejectedAt", "rejectedItems"],
      "properties": {
        "orderId": { "type": "string", "format": "uuid" },
        "reasonCode": { "const": "INSUFFICIENT_STOCK" },
        "rejectedAt": { "type": "string", "format": "date-time" },
        "rejectedItems": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/rejectedItem" }
        }
      }
    }
  }
}
