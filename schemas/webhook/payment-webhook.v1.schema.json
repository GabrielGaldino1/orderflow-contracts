{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderflow.dev/schemas/webhook/payment-webhook.v1.schema.json",
  "title": "PaymentWebhook.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "occurredAt", "data"],
  "properties": {
    "type": { "const": "payment.status.changed" },
    "version": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paymentId", "externalPaymentId", "status", "amount", "currency"],
      "properties": {
        "paymentId": { "type": "string", "format": "uuid" },
        "externalPaymentId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": { "enum": ["APPROVED", "DECLINED"] },
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
        },
        "currency": { "const": "BRL" },
        "reasonCode": {
          "enum": [
            "INSUFFICIENT_FUNDS",
            "PAYMENT_METHOD_DECLINED",
            "FRAUD_SUSPECTED",
            "INVALID_PAYMENT_METHOD",
            "UNKNOWN"
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "DECLINED" } } },
          "then": { "required": ["reasonCode"] },
          "else": { "not": { "required": ["reasonCode"] } }
        }
      ]
    }
  }
}
