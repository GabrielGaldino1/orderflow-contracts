{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderflow.dev/schemas/payment/payment-requested.v1.schema.json",
  "title": "PaymentRequested.v1",
  "allOf": [
    { "$ref": "../common/event-envelope.v1.schema.json" },
    {
      "properties": {
        "eventType": { "const": "PaymentRequested" },
        "eventVersion": { "const": 1 },
        "producer": { "const": "order-service" },
        "payload": { "$ref": "#/$defs/payload" }
      }
    }
  ],
  "$defs": {
    "amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderId", "reservationId", "amount", "currency", "paymentMethodToken"],
      "properties": {
        "orderId": { "type": "string", "format": "uuid" },
        "reservationId": { "type": "string", "format": "uuid" },
        "amount": { "$ref": "#/$defs/amount" },
        "currency": { "const": "BRL" },
        "paymentMethodToken": {
          "type": "string",
          "pattern": "^tok_[A-Za-z0-9_-]{3,120}$"
        }
      }
    }
  }
}
